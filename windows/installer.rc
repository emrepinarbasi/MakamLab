#include <windows.h>

1 RT_MANIFEST "windows10-11.manifest"
1 ICON "AppIcon.ico"

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "MakamLab Academic\0"
      VALUE "FileDescription", "MakamLab Installer\0"
      VALUE "FileVersion", "1.1.0\0"
      VALUE "InternalName", "MakamLab Setup\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 Prof. Dr. Emre PINARBASI\0"
      VALUE "OriginalFilename", "MakamLab-1.1.0-Windows-x64-Setup.exe\0"
      VALUE "ProductName", "MakamLab\0"
      VALUE "ProductVersion", "1.1.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1252
  END
END
